{
  "name": "safe-audit-fix",
  "version": "0.1.0",
  "description": "Safely fix npm audit vulnerabilities: one fix at a time, test after each, auto-revert anything that breaks. Usable as a CLI or as an MCP server for AI assistants.",
  "type": "module",
  "bin": {
    "safe-audit-fix": "src/cli.js",
    "safe-audit-fix-mcp": "src/mcp-server.js"
  },
  "main": "src/engine/index.js",
  "exports": {
    ".": "./src/engine/index.js"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "start": "node src/cli.js",
    "mcp": "node src/mcp-server.js",
    "test": "node test/mcp-smoke.js"
  },
  "keywords": [
    "npm",
    "audit",
    "security",
    "vulnerabilities",
    "fix",
    "safe",
    "mcp",
    "model-context-protocol"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.24.0"
  }
}
